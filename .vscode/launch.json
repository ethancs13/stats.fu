        {
            "name": "stats-fu (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": ["--dart-define-from-file=.env.json"]
        },
        {
            "name": "stats-fu (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": ["--dart-define-from-file=.env.json"]
        }
    ]
}
